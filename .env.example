# Next.js / NextAuth (필수)
AUTH_SECRET="your-super-secret-auth-key-at-least-32-chars"
# 배포·프록시 환경에서 canonical URL을 명시할 때 사용
AUTH_URL="http://localhost:3004"

# Cloudflare R2 Storage (Presigned URL 직접 업로드용)
# Cloudflare 대시보드 > R2 > 버킷 > API 토큰에서 발급
R2_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="portal-storage"
# R2 퍼블릭 버킷 도메인 (커스텀 도메인 또는 r2.dev 도메인)
R2_PUBLIC_URL="https://your-bucket.your-domain.com"
