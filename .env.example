# Next.js / NextAuth (필수)
AUTH_SECRET="your-super-secret-auth-key-at-least-32-chars"
# 배포·프록시 환경에서 canonical URL을 명시할 때 사용
AUTH_URL="http://localhost:3004"

# 로컬 개발용 관리자 seed (npm run dev:seed-admin)
# 실제 값은 .env.local에만 두고, 사용할 때만 opt-in을 true로 설정한다.
DEV_ADMIN_SEED_ENABLED="false"
DEV_ADMIN_EMAIL="admin@example.com"
DEV_ADMIN_PASSWORD="replace-with-a-local-only-password"
DEV_ADMIN_DISPLAY_NAME="Local Admin"

# production rollout guard. 등록 기기의 정리 신호 보급을 확인할 때까지 false로 유지한다.
ACCOUNT_DELETION_ENABLED="false"

# 외부 공개 레슨 캘린더 URL 암호화용 32-byte base64/base64url key.
# 환경별 secret에 안정적으로 보관하고 실제 값은 commit하지 않는다.
EXTERNAL_CALENDAR_ENCRYPTION_KEY="replace-with-32-byte-base64-or-base64url-key"

# Cloudflare R2 Storage (Presigned URL 직접 업로드용)
# Cloudflare 대시보드 > R2 > 버킷 > API 토큰에서 발급
R2_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="portal-storage"
# 신규 managed media는 인증 route로만 전달한다. 기존 공개 URL의 base는
# 운영 inventory/backfill 작업 입력으로만 다루고 application runtime에 두지 않는다.
