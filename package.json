{
  "name": "stann-lumo-portal",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev -p 3004",
    "dev:seed-admin": "NODE_ENV=development tsx src/scripts/setup-admin.ts",
    "db:check": "node --no-warnings scripts/check-migrations.mjs",
    "db:migrate": "npx wrangler d1 migrations apply portal-db --local",
    "db:migrate:remote": "npx wrangler d1 migrations apply portal-db --remote",
    "db:studio": "npx drizzle-kit studio",
    "db:generate": "npx drizzle-kit generate",
    "build": "next build",
    "build:worker": "node_modules/.bin/opennextjs-cloudflare build",
    "build:maintenance": "wrangler versions upload --config wrangler.maintenance.toml --dry-run --outdir .wrangler/maintenance-dry-run",
    "build:scheduled": "npm run build:worker && wrangler versions upload --config wrangler.scheduled.toml --dry-run --outdir .wrangler/scheduled-dry-run",
    "start": "next start",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "test:integration": "tsx --experimental-test-module-mocks --test --test-concurrency=1 src/test/student-action-boundary.integration.ts src/test/document-workflow.integration.ts src/test/form-draft-hook.integration.tsx src/test/document-form-shortcut.integration.tsx src/test/server-draft-sync.integration.tsx",
    "lint": "eslint src scripts eslint.config.mjs",
    "typecheck": "tsc --noEmit",
    "check:ui": "node scripts/check-ui-contracts.mjs",
    "quality": "npm run lint && npm run typecheck && npm test && npm run test:integration && npm run check:ui && npm run db:check && npm run build && npm run build:worker"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@auth/drizzle-adapter": "^1.11.3",
    "@aws-sdk/client-s3": "^3.1015.0",
    "@aws-sdk/s3-request-presigner": "^3.1015.0",
    "@fullcalendar/core": "^6.1.20",
    "@fullcalendar/daygrid": "^6.1.20",
    "@fullcalendar/interaction": "^6.1.20",
    "@fullcalendar/list": "^6.1.20",
    "@fullcalendar/react": "^6.1.20",
    "@fullcalendar/timegrid": "^6.1.20",
    "@noble/hashes": "^1.8.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@tanstack/react-table": "^8.21.3",
    "@tiptap/extension-bubble-menu": "3.29.2",
    "@tiptap/extension-code-block-lowlight": "3.29.2",
    "@tiptap/extension-floating-menu": "3.29.2",
    "@tiptap/extension-highlight": "3.29.2",
    "@tiptap/extension-image": "3.29.2",
    "@tiptap/extension-link": "3.29.2",
    "@tiptap/extension-placeholder": "3.29.2",
    "@tiptap/extension-table": "3.29.2",
    "@tiptap/extension-table-cell": "3.29.2",
    "@tiptap/extension-table-header": "3.29.2",
    "@tiptap/extension-table-row": "3.29.2",
    "@tiptap/extension-task-item": "3.29.2",
    "@tiptap/extension-task-list": "3.29.2",
    "@tiptap/extension-text-align": "3.29.2",
    "@tiptap/extension-typography": "3.29.2",
    "@tiptap/extension-underline": "3.29.2",
    "@tiptap/extension-youtube": "3.29.2",
    "@tiptap/react": "3.29.2",
    "@tiptap/starter-kit": "3.29.2",
    "@types/turndown": "^5.0.6",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "13.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.20",
    "drizzle-orm": "^0.45.1",
    "googleapis": "^171.4.0",
    "ical.js": "^2.2.1",
    "ics": "^3.8.1",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.577.0",
    "next": "15.5.22",
    "next-auth": "^5.0.0-beta.32",
    "parse5": "8.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-player": "^3.4.0",
    "recharts": "^3.8.0",
    "tailwind-merge": "^3.5.0",
    "tiptap-markdown": "^0.9.0",
    "turndown": "^7.2.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260307.1",
    "@opennextjs/cloudflare": "^1.7.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "dotenv": "^17.3.1",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9",
    "eslint-config-next": "15.5.22",
    "happy-dom": "^20.11.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "wrangler": "^4.71.0",
    "ws": "^8.19.0"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3",
    "undici": "7.29.0"
  },
  "allowScripts": {}
