# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Cloudflare & Drizzle
.wrangler/
.drizzle/

# private
.docs/private

# OpenNext / Cloudflare Workers 빌드 산출물
.open-next/

# local agent cache
/cache/

# --- 프로젝트 문서 정책 ---
# docs/ = GitHub에 올릴 공개 프로젝트 문서
# .docs/ = Obsidian 동기화/개인 작업/AI handoff 문서 (GitHub 업로드 금지)
/.docs/
!/docs/
!/docs/**/*.md
